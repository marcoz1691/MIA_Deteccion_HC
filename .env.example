# Copiar a .env (no commitear):
#   copy .env.example .env        (Windows)
#   cp .env.example .env          (Linux/macOS)
#
# API cloud solo para MEDEC / ejemplos demo.
# Para CITIMED con PHI real → Ollama local (ver bloque Ollama abajo).

# --- OpenAI / ChatGPT ---
OPENAI_API_KEY=sk-your-key-here
MOCK_LLM=false
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Transcripción de PDF escaneado (POST /extraer-pdf-estructurado) ---
# Modelo multimodal para leer las columnas NOTAS DE EVOLUCIÓN / ORDENES MEDICAS.
# Usa OPENAI_API_KEY + OPENAI_BASE_URL. Sin clave, el endpoint degrada a la capa
# de texto del PDF o a OCR local (Tesseract). OJO: enviar imágenes con PHI a un
# endpoint cloud; para PHI real apuntar OPENAI_BASE_URL a un modelo on-premise.
# VISION_MODEL=gpt-4o-mini

# --- Ollama on-premise (PHI; no enviar a cloud) ---
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# MOCK_LLM=false

# --- Anthropic / Claude (prioridad si ANTHROPIC_API_KEY está definida) ---
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/
# LLM_MODEL=claude-haiku-4-5

# --- Mistral (alternativa) ---
# MISTRAL_API_KEY=your-mistral-key-here

# --- SQLite historial de análisis (frontend + API) ---
SQLITE_PATH=data/citimed_analisis.db
HISTORIAL_MAX_ITEMS=50
