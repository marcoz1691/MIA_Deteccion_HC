# Copiar a .env (no commitear). API solo para MEDEC (datos públicos).
# Para CITIMED usar Ollama local: OPENAI_BASE_URL=http://localhost:11434/v1

OPENAI_API_KEY=sk-your-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1
# MISTRAL_API_KEY=your-mistral-key

# Modo LLM del servidor (opcional). Si está definido, ignora mock_llm del cliente.
# Desarrollo: omitir o MOCK_LLM=true  |  Producción: MOCK_LLM=false
# MOCK_LLM=true
